{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/profile/:username",
      "destination": "/profile"
    },
    {
      "source": "/collection/:collectionId",
      "destination": "/collection"
    },
    {
      "source": "/artwork/:artworkId",
      "destination": "/artwork"
    }
  ]
}
